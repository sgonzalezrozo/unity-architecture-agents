# Code style for Rider and Visual Studio. Place next to the Assets folder.
# Rules that a formatter cannot check are in .ai/architecture/CSHARP_STANDARDS.md.
# Keys starting with resharper_ apply to Rider. csharp_ and dotnet_ keys apply to Visual Studio.

root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
max_line_length = 120
resharper_csharp_wrap_lines = true

# ---------- Never use var ----------
csharp_style_var_for_built_in_types = false:error
csharp_style_var_when_type_is_apparent = false:error
csharp_style_var_elsewhere = false:error
dotnet_diagnostic.IDE0008.severity = error

resharper_csharp_for_built_in_types = use_explicit_type
resharper_csharp_for_simple_types = use_explicit_type
resharper_csharp_for_other_types = use_explicit_type
resharper_suggest_var_or_type_built_in_types_highlighting = error
resharper_suggest_var_or_type_simple_types_highlighting = error
resharper_suggest_var_or_type_elsewhere_highlighting = error

# ---------- One statement: next line, no braces ----------
csharp_prefer_braces = false
csharp_preserve_single_line_statements = false

resharper_csharp_braces_for_ifelse = not_required
resharper_csharp_braces_for_for = not_required
resharper_csharp_braces_for_foreach = not_required
resharper_csharp_braces_for_while = not_required
resharper_csharp_braces_for_dowhile = not_required
resharper_csharp_braces_for_using = not_required
resharper_csharp_braces_for_lock = not_required
resharper_csharp_braces_for_fixed = not_required
resharper_csharp_braces_redundant = true
resharper_remove_redundant_braces_highlighting = warning
resharper_csharp_place_simple_embedded_statement_on_same_line = never
resharper_csharp_keep_existing_embedded_arrangement = false

# ---------- Braces on their own line ----------
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
resharper_csharp_brace_style = next_line

# ---------- Expression bodies: arrow on a new line for methods ----------
resharper_csharp_place_expr_method_on_single_line = never
resharper_csharp_wrap_before_arrow_with_expressions = true
resharper_csharp_keep_existing_expr_member_arrangement = false

# ---------- new() when the type is on the left ----------
csharp_style_implicit_object_creation_when_type_is_apparent = true:warning
dotnet_diagnostic.IDE0090.severity = warning

resharper_csharp_object_creation_when_type_evident = target_typed
resharper_csharp_object_creation_when_type_not_evident = explicitly_typed
resharper_arrange_object_creation_when_type_evident_highlighting = warning

# ---------- Modifiers, this, namespaces, usings ----------
dotnet_style_require_accessibility_modifiers = always:warning
resharper_csharp_default_private_modifier = explicit

dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
resharper_csharp_instance_members_qualify_members = none

csharp_style_namespace_declarations = block_scoped:warning

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_diagnostic.IDE0005.severity = warning
resharper_redundant_using_directive_highlighting = warning

# ---------- Naming ----------
dotnet_diagnostic.IDE1006.severity = warning
resharper_inconsistent_naming_highlighting = warning

# Styles
dotnet_naming_style.style_pascal.capitalization = pascal_case
dotnet_naming_style.style_camel.capitalization = camel_case
dotnet_naming_style.style_all_caps.capitalization = all_upper
dotnet_naming_style.style_all_caps.word_separator = _
dotnet_naming_style.style_interface.capitalization = pascal_case
dotnet_naming_style.style_interface.required_prefix = I
dotnet_naming_style.style_event.capitalization = pascal_case
dotnet_naming_style.style_event.required_prefix = On
dotnet_naming_style.style_async.capitalization = pascal_case
dotnet_naming_style.style_async.required_suffix = Async

# Symbols
dotnet_naming_symbols.symbols_const.applicable_kinds = field
dotnet_naming_symbols.symbols_const.applicable_accessibilities = *
dotnet_naming_symbols.symbols_const.required_modifiers = const
dotnet_naming_symbols.symbols_static_readonly.applicable_kinds = field
dotnet_naming_symbols.symbols_static_readonly.applicable_accessibilities = *
dotnet_naming_symbols.symbols_static_readonly.required_modifiers = static, readonly
dotnet_naming_symbols.symbols_fields.applicable_kinds = field
dotnet_naming_symbols.symbols_fields.applicable_accessibilities = *
dotnet_naming_symbols.symbols_locals.applicable_kinds = local, parameter
dotnet_naming_symbols.symbols_locals.applicable_accessibilities = *
dotnet_naming_symbols.symbols_interfaces.applicable_kinds = interface
dotnet_naming_symbols.symbols_interfaces.applicable_accessibilities = *
dotnet_naming_symbols.symbols_events.applicable_kinds = event
dotnet_naming_symbols.symbols_events.applicable_accessibilities = *
dotnet_naming_symbols.symbols_async.applicable_kinds = method
dotnet_naming_symbols.symbols_async.applicable_accessibilities = *
dotnet_naming_symbols.symbols_async.required_modifiers = async
dotnet_naming_symbols.symbols_types_members.applicable_kinds = class, struct, enum, property, method
dotnet_naming_symbols.symbols_types_members.applicable_accessibilities = *

# Rules
dotnet_naming_rule.rule_const.symbols = symbols_const
dotnet_naming_rule.rule_const.style = style_all_caps
dotnet_naming_rule.rule_const.severity = warning
dotnet_naming_rule.rule_static_readonly.symbols = symbols_static_readonly
dotnet_naming_rule.rule_static_readonly.style = style_all_caps
dotnet_naming_rule.rule_static_readonly.severity = warning
dotnet_naming_rule.rule_fields.symbols = symbols_fields
dotnet_naming_rule.rule_fields.style = style_camel
dotnet_naming_rule.rule_fields.severity = warning
dotnet_naming_rule.rule_locals.symbols = symbols_locals
dotnet_naming_rule.rule_locals.style = style_camel
dotnet_naming_rule.rule_locals.severity = warning
dotnet_naming_rule.rule_interfaces.symbols = symbols_interfaces
dotnet_naming_rule.rule_interfaces.style = style_interface
dotnet_naming_rule.rule_interfaces.severity = warning
dotnet_naming_rule.rule_events.symbols = symbols_events
dotnet_naming_rule.rule_events.style = style_event
dotnet_naming_rule.rule_events.severity = warning
dotnet_naming_rule.rule_async.symbols = symbols_async
dotnet_naming_rule.rule_async.style = style_async
dotnet_naming_rule.rule_async.severity = warning
dotnet_naming_rule.rule_types_members.symbols = symbols_types_members
dotnet_naming_rule.rule_types_members.style = style_pascal
dotnet_naming_rule.rule_types_members.severity = warning

# ---------- Unity and FastIoC: silence false alarms ----------
# Injected internal fields and serialized fields are assigned from outside the code.
dotnet_diagnostic.CS0649.severity = none
dotnet_diagnostic.CS0169.severity = none
resharper_unassigned_field_global_highlighting = none
resharper_unassigned_field_local_highlighting = none
# Unity calls Awake, OnEnable and the like, and writes serialized fields.
dotnet_diagnostic.IDE0051.severity = none
dotnet_diagnostic.IDE0044.severity = none

# ---------- Tests use Method_Condition_Result names ----------
[Assets/Tests/**.cs]
dotnet_diagnostic.IDE1006.severity = none
resharper_inconsistent_naming_highlighting = none

# ---------- Third-party code is not ours to restyle ----------
[{Assets/Plugins/**.cs,Assets/External/**.cs}]
generated_code = true
